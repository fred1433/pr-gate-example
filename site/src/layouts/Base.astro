---
import site from '../site.json';
import '../styles.css';
interface Props { title: string; description?: string }
const { title, description = 'Mockingbird & Pike is a fictional law firm built for a software demo.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title} | Mockingbird &amp; Pike (fictional)</title>
  </head>
  <body>
    <p class="fiction">Fictional law firm built for a software demo. Not a real practice: do not send legal questions here.</p>
    <header class="top">
      <a class="brand" href={`${base}/`}>Mockingbird <span>&amp;</span> Pike</a>
      <nav>
        <a href={`${base}/#practice`}>Practice areas</a>
        <a href={`${base}/attorneys/`}>Attorneys</a>
        <a href={`${base}/contact/`}>Contact</a>
      </nav>
      <a class="call" href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
    </header>
    <main><slot /></main>
    <footer class="foot">
      <span>Mockingbird &amp; Pike, Austin, Texas. A fictional firm. <a href={`${base}/privacy/`}>Privacy</a></span>
      <a href={`tel:${site.phone.e164}`}>{site.phone.display}</a>
    </footer>
  </body>
</html>

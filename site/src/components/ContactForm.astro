---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<form class="intake" method="post" action={`${base}/api/contact/`}>
  <label for="f-name">Full name</label>
  <input id="f-name" name="name" autocomplete="name" required>
  <label for="f-email">Email</label>
  <input id="f-email" name="email" type="email" autocomplete="email" required>
  <label for="f-phone">Phone</label>
  <input id="f-phone" name="phone" type="tel" autocomplete="tel" required>
  <label for="f-details">What happened?</label>
  <textarea id="f-details" name="message" rows="5" required></textarea>
  <button type="submit">Send to our intake team</button>
</form>
